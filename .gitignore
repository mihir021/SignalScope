# ==============================================================================
# Git Ignore Configuration for SignalScope
# Covers Python environments, bytecode, Docker artifacts, and OS temp files
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Environment variables & secrets
.env
.env.local
*.pem
*.key

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db

# Docker volumes and local data directories
monitoring/grafana_data/
monitoring/prometheus_data/
